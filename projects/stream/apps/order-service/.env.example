# URL de conexão com o banco PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://app:app@postgres:5432/orders

# Nome do serviço utilizado para logs, métricas e identificação entre microsserviços
SERVICE_NAME=order-service

# Ambiente de execução da aplicação
# Valores comuns: development, test, production
NODE_ENV=development

# Lista de brokers Kafka separados por vírgula
# Exemplo: kafka1:9092,kafka2:9092
KAFKA_BROKERS=kafka:9092