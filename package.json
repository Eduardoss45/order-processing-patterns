{
  "name": "order-pipeline",
  "version": "1.0.0",
  "scripts": {
    "dev:queue": "concurrently \"npm --prefix packages/shared-validation run build\" \"npm --prefix projects/queue/apps/order-service run dev\" \"npm --prefix projects/queue/apps/worker-service run dev\""
  },
  "workspaces": [
    "packages/*",
    "projects/*/apps/*"
  ],
  "type": "commonjs",
  "dependencies": {
    "amqplib": "^1.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0"
  }
}