{
  "name": "order-pipeline",
  "version": "1.0.0",
  "scripts": {
    "build:packages": "npm run build --workspaces --if-present",
    "dev:queue": "npm run build:packages && concurrently \"npm run dev -w order-service-queue\" \"npm run dev -w worker-service\"",
    "dev:stream": "npm run build:packages && concurrently \"npm run dev -w order-service-stream\""
  },
  "workspaces": [
    "packages/*",
    "projects/*/apps/*"
  ],
  "type": "commonjs",
  "dependencies": {
    "amqplib": "^1.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "ts-node-dev": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0"
  }
}
